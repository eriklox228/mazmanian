    "style.css": {
        "prefix": "H1",
        "body": [
            "* { box-sizing: border-box; margin: 0; padding: 0; }",
            "body { font-family: Arial, sans-serif; background: #f4f6f8; color: #222; line-height: 1.5; }",
            "header { background: #2c3e50; padding: 15px 20px; }",
            "header nav a { color: #fff; text-decoration: none; margin-right: 15px; font-size: 14px; }",
            "header nav a:hover { text-decoration: underline; }",
            "main { max-width: 900px; margin: 20px auto; padding: 20px; background: #fff; border-radius: 6px; box-shadow: 0 1px 3px rgba(0,0,0,.1); }",
            "h1 { font-size: 22px; margin-bottom: 15px; color: #2c3e50; }",
            "form label { display: block; margin-bottom: 10px; font-size: 14px; }",
            "input, select, textarea { width: 100%; padding: 8px; margin-top: 4px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; }",
            "button { padding: 9px 16px; background: #3498db; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-size: 14px; transition: background .2s; }",
            "button:hover { background: #2980b9; }",
            "table { width: 100%; border-collapse: collapse; margin-top: 10px; }",
            "th, td { padding: 8px; border-bottom: 1px solid #ddd; text-align: left; font-size: 14px; }",
            "th { background: #ecf0f1; }",
            "a { color: #3498db; }",
            "footer { text-align: center; padding: 15px; font-size: 13px; color: #888; }",
            "@media (max-width: 480px) { main { margin: 10px; padding: 15px; } h1 { font-size: 18px; } header nav a { display: block; margin: 5px 0; } }"
        ]
